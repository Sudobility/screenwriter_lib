{
  "name": "@sudobility/screenwriter_lib",
  "version": "0.1.16",
  "description": "Business logic for Fadewright: stores, document session with per-user undo and epoch rebase, ports",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "BUSL-1.1",
  "author": "Sudobility",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "clean": "rimraf dist"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "dependencies": {
    "@sudobility/screenwriter_client": "^0.1.17",
    "@sudobility/screenwriter_types": "^0.1.14",
    "@sudobility/writing_core": "^0.1.5",
    "yjs": "~13.6.33"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~5.2.0",
    "happy-dom": "~20.14.6",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "rimraf": "~6.1.3",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vitest": "~4.1.12",
    "zustand": "~5.0.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/screenwriter_lib.git"
  }
}
